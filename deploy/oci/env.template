# Copy to .env on the OCI host and fill only the provider keys you actually use.
# Never commit the populated .env file.

# LiteLLM gateway authentication (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=sk-change-me

# The LiteLLM Admin UI is served on the same loopback port at /ui (reach it
# through the SSH tunnel further down). Login = username "admin" + this master
# key; no extra variable is needed. Only add UI_USERNAME/UI_PASSWORD to the
# litellm service in docker-compose.yml if you want separate UI credentials.

# Provider credentials — set at least ONE (GEMINI_API_KEY and GROQ_API_KEY
# have free tiers; DEEPSEEK_API_KEY is pay-per-token). Keys are checked at
# call time: a missing key fails that attempt and LiteLLM retries/falls back
# across the model group, so leave unset only what you don't use.
#
# Quota note (2026-09): Groq free caps ~6k tokens/min per ORG — a single
# large agent prompt can exhaust it for ~200 s. Gemini free (gemini-3.5-flash)
# has an independent quota and is the PRIMARY carrier in each model group;
# GROQ_API_KEY and GROQ_API_KEY_2 are fallbacks. A second Groq key only adds
# capacity if it belongs to a DIFFERENT Groq org (same-console keys share the
# ceiling).
# OPENROUTER_API_KEY: the free alias that was configured is retired by
# OpenRouter (HTTP 404) and was removed from litellm_config.yaml; paid
# OpenRouter models can be re-added there as openrouter/<slug> with credits.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=

# Vibe-Trading agent (LangChain-style provider config, per agent/.env.example).
# The provider is fixed to "openai" in docker-compose.yml because LiteLLM
# exposes an OpenAI-compatible API. This value becomes LANGCHAIN_MODEL_NAME,
# i.e. a LiteLLM model-group alias — not a real provider model name.
VIBE_TRADING_MODEL=vibe-trading-critical

# Bearer token for the Vibe-Trading API on :8899. Required before exposing
# the port beyond localhost; leave empty only while the port stays firewalled.
VIBE_TRADING_API_AUTH_KEY=

# Hermes Docker identity and local-only dashboard.
HERMES_UID=1000
HERMES_GID=1000
HERMES_DASHBOARD=1
API_SERVER_ENABLED=false
API_SERVER_KEY=

# ---------------------------------------------------------------------------
# Operator UI access (SSH tunnels — never expose these ports publicly)
# ---------------------------------------------------------------------------
# Vibe-Trading Web UI + REST API: runs list, per-run dashboard, Run Card,
# sessions, swarm, live-trading panel and Settings -> LLM providers.
#   ssh -N -L 8899:127.0.0.1:8899 ubuntu@<oci-host>   then http://127.0.0.1:8899
# LiteLLM Admin UI: model groups, deployment health, request logs, test calls.
#   ssh -N -L 4000:127.0.0.1:4000 ubuntu@<oci-host>   then http://127.0.0.1:4000/ui
# Both tunnels in one command:
#   ssh -N -L 8899:127.0.0.1:8899 -L 4000:127.0.0.1:4000 ubuntu@<oci-host>
#
# Notes:
#   - Keep 8899/8900/4000/8642/9119 closed in the OCI ingress rules. Even if a
#     port were reachable, Vibe-Trading refuses non-loopback API calls while
#     API_AUTH_KEY is empty ("API_AUTH_KEY is required for non-local API
#     access"), so the tunnel is the only practical path to the UI.
#   - A tunnel arrives from 127.0.0.1, so no key is needed while
#     VIBE_TRADING_API_AUTH_KEY stays empty. Setting it makes EVERY request
#     carry a bearer token, browser UI included — leave it empty unless you are
#     deliberately exposing :8899.
#   - The Vibe-Trading SPA is built into the image (stage 1 of
#     vibe-trading.Dockerfile): the Python package ships no frontend, so an
#     image built without that stage serves the REST API with no UI. After any
#     image change, prove which of the two the running container took —
#     `bash verify-ui.sh` rebuilds vibe-trading + bridge, waits for serve to
#     announce its frontend directory, then checks the SPA shell, a hashed
#     bundle, a deep link and /openapi.json, naming the failing check instead of
#     leaving you with a blank page. `bash verify-ui.sh --no-build`
#     only inspects the running stack.
#   - The LiteLLM UI needs DATABASE_URL (Postgres) for the DB-backed tabs
#     (virtual keys, teams, spend history). With no database it still lists the
#     model groups and runs test calls.

# seeds-lite: Upstash Redis credentials for the keyless seeder loop that
# feeds the fork's Vercel MCP tools. Copy these from the Vercel project
# worldmonitor-weneko → Settings → Environment Variables; the same two values
# the fork's edge functions already use. Without them seeds-lite exits loudly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# UCDP GED API access token (free registration at ucdp.uu.se — their API now
# requires x-ucdp-access-token). Needed by the seeds-lite `ucdp` seeder, which
# otherwise gets HTTP 401. Same token the operator-side relay uses.
UCDP_ACCESS_TOKEN=

# seed-insights digest warm: point at THIS fork's Vercel deployment and use the
# relay key that matches the fork's WORLDMONITOR_VALID_KEYS (same values as the
# API_BASE_URL / WORLDMONITOR_RELAY_KEY GitHub secrets used by seed-upstash.yml).
# Without both, the digest warm is rejected and insights runs skip their write.
API_BASE_URL=https://worldmonitor-weneko.vercel.app
WORLDMONITOR_RELAY_KEY=

# social-velocity: Reddit blocks the OCI datacenter IP on the anonymous .json
# API (HTTP 403 on first deploy). The relay ops fetches Reddit via
# ScrapeCreators (vendor key) or Reddit OAuth (free) — same precedence as the
# relay: ScrapeCreators -> OAuth -> public. Configure either option:
#   - SCRAPECREATORS_API_KEY: free tier exists at scrapecreators.com.
#   - REDDIT_CLIENT_ID + REDDIT_CLIENT_SECRET: "script" app created at
#     reddit.com/prefs/apps (redirect uri http://localhost:8080). Userless
#     token, works from any IP, 0 cost.
# REDDIT_USER_AGENT: optional; Reddit requires a descriptive UA
# "<platform>:<appid>:<version> (by /u/<your-username>)".
SCRAPECREATORS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# feed-intel (deploy/oci/feeds): dependency-free RSS/Atom/scrape poller for
# the Macro Director layer. No credentials required — the only knob is the
# loop tick in seconds (each source additionally obeys its own pollIntervalS
# in feeds/sources.json, which Hermès can edit live).
FEED_POLL_S=60
# Append-only SQLite history (first-seen items + per-poll stats), written on
# the same volume for backtests. Defaults to <state>/archive.sqlite.
# FEED_ARCHIVE_DB=

# directive-bridge: paper connector profile the agent is instructed to use.
# Default alpaca-paper-trade; set binance-paper-trade to trade the Binance
# spot testnet (see bridge/README.md). When switching connectors, also
# switch the runtime-selected profile in
# ~/.vibe-trading/trading-connections.json (the fill check reads positions
# through the selected profile, not this env var).
BRIDGE_CONNECTOR=alpaca-paper-trade

# Add broker credentials only for a separately approved paper/live deployment.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# Binance: create keys on https://testnet.binance.vision (GitHub login) and
# write them into ~/.vibe-trading/binance.json (vibe_data volume) as
# {"api_key": ..., "api_secret": ..., "profile": "paper"} — the connector
# reads its own JSON, exactly like alpaca.json.
# OANDA practice: see deploy/oci/upstream/oanda-vibe-trading-pr/ (config
# ~/.vibe-trading/oanda.json with api_key + account_id).