# Copy to .env on the OCI host and fill only the provider keys you actually use.
# Never commit the populated .env file.

# LiteLLM gateway authentication (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=sk-change-me

# Free-tier/provider credentials. LiteLLM skips providers that are unavailable.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Vibe-Trading agent (LangChain-style provider config, per agent/.env.example).
# The provider is fixed to "openai" in docker-compose.yml because LiteLLM
# exposes an OpenAI-compatible API. This value becomes LANGCHAIN_MODEL_NAME,
# i.e. a LiteLLM model-group alias — not a real provider model name.
VIBE_TRADING_MODEL=vibe-trading-critical

# Bearer token for the Vibe-Trading API on :8899. Required before exposing
# the port beyond localhost; leave empty only while the port stays firewalled.
VIBE_TRADING_API_AUTH_KEY=

# Hermes Docker identity and local-only dashboard.
HERMES_UID=1000
HERMES_GID=1000
HERMES_DASHBOARD=1
API_SERVER_ENABLED=false
API_SERVER_KEY=

# seeds-lite: Upstash Redis credentials for the keyless seeder loop that
# feeds the fork's Vercel MCP tools. Copy these from the Vercel project
# worldmonitor-weneko → Settings → Environment Variables; the same two values
# the fork's edge functions already use. Without them seeds-lite exits loudly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# UCDP GED API access token (free registration at ucdp.uu.se — their API now
# requires x-ucdp-access-token). Needed by the seeds-lite `ucdp` seeder, which
# otherwise gets HTTP 401. Same token the operator-side relay uses.
UCDP_ACCESS_TOKEN=

# Add broker credentials only for a separately approved paper/live deployment.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
