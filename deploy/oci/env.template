# Copy to .env on the OCI host and fill only the provider keys you actually use.
# Never commit the populated .env file.

# LiteLLM gateway authentication (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=sk-change-me

# Free-tier/provider credentials. LiteLLM skips providers that are unavailable.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Vibe-Trading agent (LangChain-style provider config, per agent/.env.example).
# The provider is fixed to "openai" in docker-compose.yml because LiteLLM
# exposes an OpenAI-compatible API. This value becomes LANGCHAIN_MODEL_NAME,
# i.e. a LiteLLM model-group alias — not a real provider model name.
VIBE_TRADING_MODEL=vibe-trading-critical

# Bearer token for the Vibe-Trading API on :8899. Required before exposing
# the port beyond localhost; leave empty only while the port stays firewalled.
VIBE_TRADING_API_AUTH_KEY=

# Hermes Docker identity and local-only dashboard.
HERMES_UID=1000
HERMES_GID=1000
HERMES_DASHBOARD=1
API_SERVER_ENABLED=false
API_SERVER_KEY=

# seeds-lite: Upstash Redis credentials for the keyless seeder loop that
# feeds the fork's Vercel MCP tools. Copy these from the Vercel project
# worldmonitor-weneko → Settings → Environment Variables; the same two values
# the fork's edge functions already use. Without them seeds-lite exits loudly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# UCDP GED API access token (free registration at ucdp.uu.se — their API now
# requires x-ucdp-access-token). Needed by the seeds-lite `ucdp` seeder, which
# otherwise gets HTTP 401. Same token the operator-side relay uses.
UCDP_ACCESS_TOKEN=

# seed-insights digest warm: point at THIS fork's Vercel deployment and use the
# relay key that matches the fork's WORLDMONITOR_VALID_KEYS (same values as the
# API_BASE_URL / WORLDMONITOR_RELAY_KEY GitHub secrets used by seed-upstash.yml).
# Without both, the digest warm is rejected and insights runs skip their write.
API_BASE_URL=https://worldmonitor-weneko.vercel.app
WORLDMONITOR_RELAY_KEY=

# social-velocity: Reddit blocks the OCI datacenter IP on the anonymous .json
# API (HTTP 403 on first deploy). The relay ops fetches Reddit via
# ScrapeCreators (vendor key) or Reddit OAuth (free) — same precedence as the
# relay: ScrapeCreators -> OAuth -> public. Configure either option:
#   - SCRAPECREATORS_API_KEY: free tier exists at scrapecreators.com.
#   - REDDIT_CLIENT_ID + REDDIT_CLIENT_SECRET: "script" app created at
#     reddit.com/prefs/apps (redirect uri http://localhost:8080). Userless
#     token, works from any IP, 0 cost.
# REDDIT_USER_AGENT: optional; Reddit requires a descriptive UA
# "<platform>:<appid>:<version> (by /u/<your-username>)".
SCRAPECREATORS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# feed-intel (deploy/oci/feeds): dependency-free RSS/Atom/scrape poller for
# the Macro Director layer. No credentials required — the only knob is the
# loop tick in seconds (each source additionally obeys its own pollIntervalS
# in feeds/sources.json, which Hermès can edit live).
FEED_POLL_S=60

# Add broker credentials only for a separately approved paper/live deployment.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
