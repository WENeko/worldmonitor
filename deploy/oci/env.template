# ============================================================================
# Vibe-Trading — environment variables (free-tier optimized)
# ============================================================================
# Copy this file to .env and fill in the values:
#   cp env.template .env
#
# ---- FREE PROVIDER STRATEGY ----
# Primary:   DeepSeek — crédits gratuits, excellent raisonnement financier
# Fallback:  FCC (free-claude-code) — proxy local avec 50+ providers gratuits
# Last-resort: OpenRouter free models — sans clé si urgence absolue
#
# Sans FCC (simple) : DeepSeek direct, switch manuel si indispo
# Avec FCC (robuste) : Vibe-Trading → FCC → DeepSeek > Gemini > NVIDIA > ...
# ============================================================================

# ----- Primary LLM: DeepSeek (crédits gratuits) -----
# Crée un compte sur https://platform.deepseek.com/api_keys
# Les crédits gratuits sont généreux (~1M tokens/mois environ)
DEEPSEEK_API_KEY=sk-...

# ----- Vibe-Trading Configuration -----
# Provider list: deepseek | openrouter | anthropic | openai | gemini | copilot | groq | novita
VIBE_TRADING_PROVIDER=deepseek

# Model (leave blank for provider default — DeepSeek: deepseek-chat)
# VIBE_TRADING_MODEL=

# LLM call timeout in seconds (default: 300).
VIBE_TRADING_LLM_TIMEOUT_SECONDS=300

# ----- Optional: FCC Safety Net (recommended for production) -----
# When FCC is installed natively on the host, point Vibe-Trading at it
# instead of DeepSeek directly. FCC handles all provider fallback.
#
# How to switch to FCC:
#   1. Install FCC: curl -fsSL "https://raw.githubusercontent.com/Alishahryar1/free-claude-code/main/scripts/install.sh" | sh
#   2. Start FCC:   fcc-server
#   3. Open Admin UI, configure DeepSeek (primary) + NVIDIA NIM (fallback)
#   4. Uncomment below and comment out DEEPSEEK_API_KEY + VIBE_TRADING_PROVIDER=deepseek above:
#
# VIBE_TRADING_PROVIDER=openrouter
# OPENROUTER_API_KEY=fcc-proxy
# OPENROUTER_BASE_URL=http://localhost:8082

# ----- Optional: Additional providers for manual fallback -----
# OpenRouter (free models: Gemini Flash, Llama 3.3, Qwen 3)
# OPENROUTER_API_KEY=sk-or-...

# Gemini (free tier: 1,500 req/jour)
# GEMINI_API_KEY=...

# Groq (free tier: bon pour vitesse, moins bon en raisonnement)
# GROQ_API_KEY=...

# ----- Broker Credentials (add when ready for live trading) -----
# Alpaca Markets (paper trading: https://paper-api.alpaca.markets)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# Interactive Brokers
# See: https://vibetrading.wiki/docs/latest/brokers/ibkr/