# Copy to .env on the OCI host and fill only the provider keys you actually use.
# Never commit the populated .env file.

# LiteLLM gateway authentication (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=sk-change-me

# ---------------------------------------------------------------------------
# LiteLLM Admin UI (same loopback port, at /ui)
# ---------------------------------------------------------------------------
# The UI needs a database. With no DATABASE_URL, LiteLLM answers /ui with its
# own "Environment Setup Instructions / Missing Environment Variables:
# DATABASE_URL" page instead of the app — on HTTP 200 text/html, so a status
# check looks healthy while nobody can log in. docker-compose.yml starts
# litellm-db (Postgres, loopback-only port 5432) and points DATABASE_URL at it.
LITELLM_DB_PASSWORD=litellm-local-change-me

# Encrypts provider credentials stored in the database. LiteLLM documents this
# as IMMUTABLE: change it after the DB holds data and stored models become
# unreadable. Set it before creating anything in the UI (openssl rand -hex 32).
LITELLM_SALT_KEY=

# UI login. Set BOTH — they are the documented credentials. The fallback
# (username "admin" + LITELLM_MASTER_KEY) is exactly what answers "Invalid
# credentials used to access UI. Check 'UI_USERNAME', 'UI_PASSWORD' in .env
# file" in the field reports (litellm issues #9243, #9418, #9264). Blank values
# are falsy in LiteLLM, so an empty pair keeps the fallback rather than
# disabling login.
UI_USERNAME=admin
UI_PASSWORD=

# Budgets for the Prisma CLI that litellm drives at startup. Every migration
# step is a separate node process, and the upstream defaults (60 s per command,
# 600 s for the one-time toolchain bootstrap) are buried in the Python package.
# Uncomment and raise these on a slow host or one with a tight CPU limit; an
# explicit value also makes a slow startup tell you WHICH budget it hit.
# Diagnose a startup that never binds :4000 with:
#   docker stats --no-stream litellm     # pinned at its quota, or idle?
#   docker logs litellm | wc -c          # ZERO bytes = stuck, not crashed
# LITELLM_PRISMA_BOOTSTRAP_TIMEOUT=600
# LITELLM_PRISMA_COMMAND_TIMEOUT=180

# Provider credentials — set at least ONE (GEMINI_API_KEY and GROQ_API_KEY
# have free tiers; DEEPSEEK_API_KEY is pay-per-token). Keys are checked at
# call time: a missing key fails that attempt and LiteLLM retries/falls back
# across the model group, so leave unset only what you don't use.
#
# Quota note (2026-09): Groq free caps ~6k tokens/min per ORG — a single
# large agent prompt can exhaust it for ~200 s. Gemini free (gemini-3.5-flash)
# has an independent quota and is the PRIMARY carrier in each model group;
# GROQ_API_KEY and GROQ_API_KEY_2 are fallbacks. A second Groq key only adds
# capacity if it belongs to a DIFFERENT Groq org (same-console keys share the
# ceiling).
# OPENROUTER_API_KEY: the free alias that was configured is retired by
# OpenRouter (HTTP 404) and was removed from litellm_config.yaml; paid
# OpenRouter models can be re-added there as openrouter/<slug> with credits.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=

# Vibe-Trading agent (LangChain-style provider config, per agent/.env.example).
# The provider is fixed to "openai" in docker-compose.yml because LiteLLM
# exposes an OpenAI-compatible API. This value becomes LANGCHAIN_MODEL_NAME,
# i.e. a LiteLLM model-group alias — not a real provider model name.
VIBE_TRADING_MODEL=vibe-trading-critical

# Bearer token for the Vibe-Trading API on :8899. Required before exposing
# the port beyond localhost; leave empty only while the port stays firewalled.
VIBE_TRADING_API_AUTH_KEY=

# Host allow-list for the loopback DNS-rebinding guard (env alias
# API_ALLOWED_HOSTS in the agent's env_schema) — the one reason a *correct*
# reverse proxy still gets 403. Any TLS front end that forwards to
# 127.0.0.1:8899 makes the API see a loopback PEER carrying a NON-loopback Host
# header (`tailscale serve` forwards the browser's Host verbatim), and the
# guard trusts the peer but rejects the Host unless it is listed here:
#   403 {"detail": "Untrusted local API host"}
# on every request, with the container healthy and nothing in the logs.
# tailscale/setup-tailscale.sh derives this node's MagicDNS name and writes it
# (comma-separated for several names). Empty when nothing proxies to :8899.
API_ALLOWED_HOSTS=

# Hermes Docker identity and local-only dashboard.
HERMES_UID=1000
HERMES_GID=1000
HERMES_DASHBOARD=1
API_SERVER_ENABLED=false
API_SERVER_KEY=

# Hermes dashboard over the tailnet (used by tailscale/setup-tailscale.sh).
#
# Empty keeps the dashboard loopback-only: it then accepts only Host 127.0.0.1,
# so the `tailscale serve` mapping on :9443 answers
#   HTTP 400 {"detail":"Invalid Host header. Dashboard requests must use the
#   bound hostname or the configured public hostname."}
# Declaring a public URL engages the dashboard auth gate, which fails CLOSED:
# without a registered provider the dashboard refuses to bind at all. So set the
# two credentials first, recreate hermes, and only then let the script write
# HERMES_DASHBOARD_PUBLIC_URL (it does that on its own once it sees both).
#   HERMES_DASHBOARD_BASIC_AUTH_USERNAME=<user>
#   HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<password>
# The bundled `basic` provider reads these; no external IDP is involved. Add
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=<random> as well if you want sessions to
# survive a restart (otherwise a per-process key is generated).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Operator UI access (tailnet via Tailscale — SSH tunnels as the fallback)
# ---------------------------------------------------------------------------
# Two ways in; they are alternatives, not layers. On both paths 8899/8900/4000/
# 8642/9119 stay closed in the OCI ingress rules — never publish them on the
# public IP.
#
# (A) Tailnet via Tailscale — RECOMMENDED. The OCI host serves the UI itself,
#     so every device already on your tailnet (laptop, phone, browser) opens it
#     with no tunnel and no client-side script, over a real TLS certificate,
#     and with no change to the OCI ingress rules:
#       https://<node>.<tailnet>.ts.net/          Vibe-Trading Web UI + REST API
#       https://<node>.<tailnet>.ts.net:8443/ui   LiteLLM Admin UI
#       https://<node>.<tailnet>.ts.net:9443/     Hermes dashboard (loopback :9119)
#     One command on this host does everything: it derives the MagicDNS name,
#     writes API_ALLOWED_HOSTS above, publishes the three `tailscale serve`
#     mappings and then proves the path with its own HTTPS request. It installs
#     nothing unless you pass --install.
#       bash tailscale/setup-tailscale.sh            # configure + verify
#       bash tailscale/setup-tailscale.sh --check    # report only, no changes
#       bash tailscale/setup-tailscale.sh --dry-run  # print what would change
#       bash tailscale/setup-tailscale.sh --reset    # remove the mappings
#     Needs MagicDNS + HTTPS Certificates enabled for the tailnet (Tailscale
#     admin console -> DNS). See deploy/oci/tailscale/README.md.
#
# (B) SSH tunnel — the fallback, and the only option when a tailnet is not
#     available. Vibe-Trading Web UI + REST API: runs list, per-run dashboard,
#     Run Card, sessions, swarm, live-trading panel and Settings -> LLM
#     providers.
#   ssh -N -L 8899:127.0.0.1:8899 ubuntu@<oci-host>   then http://127.0.0.1:8899
# LiteLLM Admin UI: model groups, deployment health, request logs, test calls
# (login: UI_USERNAME + UI_PASSWORD from this file).
#   ssh -N -L 4000:127.0.0.1:4000 ubuntu@<oci-host>   then http://127.0.0.1:4000/ui
# Both tunnels in one command:
#   ssh -N -L 8899:127.0.0.1:8899 -L 4000:127.0.0.1:4000 ubuntu@<oci-host>
#
# That bare ssh dies on laptop sleep, a Wi-Fi change or an OCI reboot and
# nothing brings it back. deploy/oci/tunnel/ makes it a service that survives
# all three — copy the directory to the machine with the BROWSER (not the host)
# and run, once:
#   bash install.sh ubuntu@<oci-host>            # Linux: systemd user unit
#                                                # macOS: LaunchAgent
#   powershell -ExecutionPolicy Bypass -File install-windows.ps1 -SshHost ubuntu@<oci-host>
#   bash ocitunnel.sh --check                    # prerequisites + reachability
# See deploy/oci/tunnel/README.md.
#
# Notes:
#   - Keep 8899/8900/4000/8642/9119 closed in the OCI ingress rules. Even if a
#     port were reachable, Vibe-Trading refuses non-loopback API calls while
#     API_AUTH_KEY is empty ("API_AUTH_KEY is required for non-local API
#     access"), so a tunnel and `tailscale serve` — both of which arrive from a
#     loopback peer — are the only practical paths to the UI.
#   - Both paths arrive from 127.0.0.1, so no key is needed while
#     VIBE_TRADING_API_AUTH_KEY stays empty. Setting it makes EVERY request
#     carry a bearer token, browser UI included — leave it empty unless you are
#     deliberately exposing :8899.
#   - A reverse proxy needs API_ALLOWED_HOSTS (above); an SSH tunnel does not,
#     because it forwards to 127.0.0.1 and the browser uses 127.0.0.1 as Host.
#   - The Vibe-Trading SPA is built into the image (stage 1 of
#     vibe-trading.Dockerfile): the Python package ships no frontend, so an
#     image built without that stage serves the REST API with no UI. After any
#     image change, prove which of the two the running container took —
#     `bash verify-ui.sh` rebuilds vibe-trading + bridge, waits for serve to
#     announce its frontend directory, then checks the SPA shell, a hashed
#     bundle, a deep link and /openapi.json, naming the failing check instead of
#     leaving you with a blank page. `bash verify-ui.sh --no-build`
#     only inspects the running stack.
#   - The LiteLLM UI needs DATABASE_URL (Postgres) — not only for the DB-backed
#     tabs (virtual keys, teams, spend history) but to serve the UI at all:
#     without a database LiteLLM returns its "Environment Setup Instructions"
#     page on /ui and its login endpoint cannot authenticate anyone. That page
#     is HTTP 200 text/html, so `bash verify-ui.sh` inspects the /ui body and
#     names this case instead of reporting a healthy gateway.

# seeds-lite: Upstash Redis credentials for the keyless seeder loop that
# feeds the fork's Vercel MCP tools. Copy these from the Vercel project
# worldmonitor-weneko → Settings → Environment Variables; the same two values
# the fork's edge functions already use. Without them seeds-lite exits loudly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# UCDP GED API access token (free registration at ucdp.uu.se — their API now
# requires x-ucdp-access-token). Needed by the seeds-lite `ucdp` seeder, which
# otherwise gets HTTP 401. Same token the operator-side relay uses.
UCDP_ACCESS_TOKEN=

# seed-insights digest warm: point at THIS fork's Vercel deployment and use the
# relay key that matches the fork's WORLDMONITOR_VALID_KEYS (same values as the
# API_BASE_URL / WORLDMONITOR_RELAY_KEY GitHub secrets used by seed-upstash.yml).
# Without both, the digest warm is rejected and insights runs skip their write.
API_BASE_URL=https://worldmonitor-weneko.vercel.app
WORLDMONITOR_RELAY_KEY=

# social-velocity: Reddit blocks the OCI datacenter IP on the anonymous .json
# API (HTTP 403 on first deploy). The relay ops fetches Reddit via
# ScrapeCreators (vendor key) or Reddit OAuth (free) — same precedence as the
# relay: ScrapeCreators -> OAuth -> public. Configure either option:
#   - SCRAPECREATORS_API_KEY: free tier exists at scrapecreators.com.
#   - REDDIT_CLIENT_ID + REDDIT_CLIENT_SECRET: "script" app created at
#     reddit.com/prefs/apps (redirect uri http://localhost:8080). Userless
#     token, works from any IP, 0 cost.
# REDDIT_USER_AGENT: optional; Reddit requires a descriptive UA
# "<platform>:<appid>:<version> (by /u/<your-username>)".
SCRAPECREATORS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# feed-intel (deploy/oci/feeds): dependency-free RSS/Atom/scrape poller for
# the Macro Director layer. No credentials required — the only knob is the
# loop tick in seconds (each source additionally obeys its own pollIntervalS
# in feeds/sources.json, which Hermès can edit live).
FEED_POLL_S=60
# Append-only SQLite history (first-seen items + per-poll stats), written on
# the same volume for backtests. Defaults to <state>/archive.sqlite.
# FEED_ARCHIVE_DB=

# directive-bridge: paper connector profile the agent is instructed to use.
# Default alpaca-paper-trade; set binance-paper-trade to trade the Binance
# spot testnet (see bridge/README.md). When switching connectors, also
# switch the runtime-selected profile in
# ~/.vibe-trading/trading-connections.json (the fill check reads positions
# through the selected profile, not this env var).
BRIDGE_CONNECTOR=alpaca-paper-trade

# Add broker credentials only for a separately approved paper/live deployment.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# Binance: create keys on https://testnet.binance.vision (GitHub login) and
# write them into ~/.vibe-trading/binance.json (vibe_data volume) as
# {"api_key": ..., "api_secret": ..., "profile": "paper"} — the connector
# reads its own JSON, exactly like alpaca.json.
# OANDA practice: see deploy/oci/upstream/oanda-vibe-trading-pr/ (config
# ~/.vibe-trading/oanda.json with api_key + account_id).